pipeline {
    agent any

    // 파이프라인 전체에서 사용할 환경 변수 선언
    environment {
        PROJECT_DIR = '/home/ubuntu/projects/store-system'  // 소스 코드가 위치한 메인 프로젝트 디렉터리
        GIT_BRANCH = 'develop-ubuntu'                       // 배포에 사용할 Git 브랜치 이름
    }

    // GitHub에서 Push 이벤트 발생 시 자동으로 파이프라인 실행
    triggers {
        githubPush()
    }

    stages {
        // ① Git 저장소에서 프로젝트 최신 코드 가져오기
        stage('Update Code from Git') {
            steps {
                script {
                    sh """
                        echo "[Git] ${PROJECT_DIR}에서 최신 코드로 업데이트를 시작합니다..."

                        # 프로젝트 디렉터리에 이미 .git 디렉터리가 있다면, git pull로 최신 상태 유지
                        if [ -d "${PROJECT_DIR}/.git" ]; then
                            echo "[Git] 저장소가 이미 존재합니다. 최신 변경사항을 pull합니다."
                            sudo -u ubuntu bash -c "
                                cd ${PROJECT_DIR}
                                git fetch origin ${GIT_BRANCH}
                                git checkout ${GIT_BRANCH}
                                git pull origin ${GIT_BRANCH}
                                git log -1 --oneline
                            "
                        else
                            # .git 디렉터리가 없다면, 저장소를 새로 clone합니다.
                            echo "[Git] 저장소가 없습니다. 클론을 진행합니다."
                            sudo mkdir -p ${PROJECT_DIR}
                            sudo chown ubuntu:ubuntu ${PROJECT_DIR}
                            sudo -u ubuntu bash -c "
                                cd ${PROJECT_DIR}
                                git clone -b ${GIT_BRANCH} https://github.com/WinningSolution/Store-Management-System-Python.git .
                                git log -1 --oneline
                            "
                        fi
                    """
                }
            }
        }

        // ② Docker Compose를 사용하여 어플리케이션 빌드 및 배포
        stage('Build and Deploy with Docker Compose') {
            steps {
                script {
                    sh """
                        cd ${PROJECT_DIR}
                        echo "[Docker] 현재 작업 디렉터리: \$(pwd)"
                        
                        # 기존에 실행 중인 컨테이너 중지 및 삭제
                        echo "[Docker] 기존 컨테이너들을 중지합니다..."
                        docker compose down || true
                        
                        # 전체 이미지를 새로 빌드하고 백그라운드로 컨테이너 실행
                        echo "[Docker] 이미지를 새로 빌드하고 컨테이너를 시작합니다..."
                        docker compose build --no-cache
                        docker compose up -d
                        
                        # 서비스가 기동될 수 있도록 잠시 대기
                        echo "[Docker] 서비스가 준비될 때까지 15초 대기합니다..."
                        sleep 15
                        
                        # 컨테이너 상태 확인
                        echo "[Docker] 컨테이너 상태를 확인합니다."
                        docker compose ps
                    """
                }
            }
        }

        // ③ 배포된 서비스 헬스 체크(정상 기동 확인)
        stage('Health Check') {
            steps {
                script {
                    sh '''
                        echo "[HealthCheck] 모든 서비스가 안정화될 때까지 10초 대기 중..."
                        sleep 10

                        # 백엔드 API 헬스 엔드포인트를 호출하여 정상인지 확인
                        echo "[HealthCheck] 백엔드(FASTAPI) 헬스 체크 수행 중..."
                        curl -f http://localhost/api/v1/health || echo "⚠️ 백엔드 헬스 체크 실패 (엔드포인트가 없으면 정상일 수도 있음)"
                        
                        # 프론트엔드 정적 페이지 로드 가능 여부 확인
                        echo "[HealthCheck] 프론트엔드 서버 접속 가능 여부 확인..."
                        curl -f http://localhost/ -o /dev/null && echo "✅ 프론트엔드 OK" || echo "⚠️ 프론트엔드 접속 실패"
                        
                        # 최근 백엔드 컨테이너 로그 일부 출력
                        echo "[HealthCheck] 백엔드 컨테이너 최근 로그(20줄) 출력:"
                        cd /home/ubuntu/projects/store-system
                        docker compose logs --tail=20 backend
                    '''
                }
            }
        }
    }

    // 파이프라인 후처리 : 성공, 실패, 항상 등 결과별로 별도 처리
    post {
        success {
            echo "✅ 파이프라인 성공! 서비스가 정상적으로 배포되었습니다."
            script {
                sh '''
                    cd /home/ubuntu/projects/store-system
                    echo "=== [상태] 현재 컨테이너 목록 ==="
                    docker compose ps
                    echo ""
                    echo "=== [로그] 최근 전체 로그(30줄) ==="
                    docker compose logs --tail=30
                '''
            }
        }
        failure {
            echo "❌ 파이프라인 실패! 상세 로그를 확인해주세요."
            script {
                sh '''
                    cd /home/ubuntu/projects/store-system
                    echo "=== [상태] 현재 컨테이너 목록 ==="
                    docker compose ps || true
                    echo ""
                    echo "=== [로그] 에러 및 최근 전체 로그(100줄) ==="
                    docker compose logs --tail=100 || true
                '''
            }
        }
        always {
            echo "파이프라인 실행이 종료되었습니다."
            script {
                sh '''
                    cd /home/ubuntu/projects/store-system

                    # Jenkins 임시 폴더 정리
                    rm -rf store-system-deploy@tmp 2>/dev/null || true
                '''
            }
        }
    }
}