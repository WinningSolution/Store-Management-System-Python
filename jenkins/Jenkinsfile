pipeline {
    agent any

    environment {
        PROJECT_DIR = '/home/ubuntu/projects/store-system'
        GIT_BRANCH = 'develop-ubuntu'
    }

    stages {
        // ① 프로젝트 디렉토리에서 Git으로 최신 코드 가져오기
        stage('Update Code from Git') {
            steps {
                script {
                    sh """
                        echo "Updating code in ${PROJECT_DIR}..."
                        
                        if [ -d "${PROJECT_DIR}/.git" ]; then
                            echo "Git repository exists, pulling latest changes..."
                            cd ${PROJECT_DIR}
                            git fetch origin ${GIT_BRANCH}
                            git checkout ${GIT_BRANCH}
                            git pull origin ${GIT_BRANCH}
                            git log -1 --oneline
                        else
                            echo "Git repository not found, cloning..."
                            mkdir -p ${PROJECT_DIR}
                            cd ${PROJECT_DIR}
                            git clone -b ${GIT_BRANCH} https://github.com/WinningSolution/Store-Management-System-Python.git .
                            git log -1 --oneline
                        fi
                    """
                }
            }
        }

        // ② Docker Compose로 빌드 및 배포
        stage('Build and Deploy with Docker Compose') {
            steps {
                script {
                    dir("${PROJECT_DIR}") {
                        sh '''
                            echo "Current directory: $(pwd)"
                            echo "Stopping existing containers..."
                            docker compose down || true
                            
                            echo "Building and starting containers..."
                            docker compose build --no-cache
                            docker compose up -d
                            
                            echo "Waiting for services to be ready..."
                            sleep 15
                            
                            echo "Checking container status..."
                            docker compose ps
                        '''
                    }
                }
            }
        }

        // ③ 헬스 체크
        stage('Health Check') {
            steps {
                script {
                    sh '''
                        echo "Waiting for services to stabilize..."
                        sleep 10
                        
                        echo "Checking backend health..."
                        curl -f http://localhost/api/v1/health || echo "⚠️ Backend health check failed (may be normal if endpoint doesn't exist)"
                        
                        echo "Checking frontend..."
                        curl -f http://localhost/ -o /dev/null && echo "✅ Frontend is accessible" || echo "⚠️ Frontend check failed"
                        
                        echo "Checking container logs..."
                        docker compose logs --tail=20 backend
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline succeeded! Services deployed successfully."
            script {
                sh '''
                    echo "=== Container Status ==="
                    docker compose ps
                    echo ""
                    echo "=== Recent Logs ==="
                    docker compose logs --tail=30
                '''
            }
        }
        failure {
            echo "❌ Pipeline failed! Check the logs for details."
            script {
                sh '''
                    echo "=== Container Status ==="
                    docker compose ps || true
                    echo ""
                    echo "=== Error Logs ==="
                    docker compose logs --tail=100 || true
                '''
            }
        }
        always {
            echo "Pipeline execution completed."
        }
    }
}